{
  "manifest_version": "v3.edge_local_data_plane.v1",
  "customer": {
    "name": "third-party-demo",
    "technical_contact": "owner@example.com"
  },
  "environment": {
    "name": "local-edge-demo",
    "execution_profile": "local_strict",
    "allow_http_loopback": true
  },
  "v3_control_plane": {
    "base_url": "https://v3.elepcloud.com",
    "stores_source_documents": false,
    "stores_parsed_text": false,
    "stores_vector_index": false,
    "stores_generated_html": false,
    "allowed_data_classes": [
      "redacted_status",
      "artifact_hash",
      "source_counts",
      "capability_manifest"
    ]
  },
  "edge_agent": {
    "hosted_by": "third_party",
    "public_base_url": "http://127.0.0.1:8787",
    "browser_calls_v3_directly": false,
    "exposes_browser_token": false,
    "capabilities": {
      "local_document_parse": true,
      "local_acl_filter": true,
      "local_retrieval": true,
      "local_answer_generation": true,
      "local_page_generation": true,
      "local_artifact_publish": true
    }
  },
  "data_plane": {
    "document_store": {
      "owner": "third_party",
      "location_label": "customer-document-service",
      "source_documents_leave_customer_network": false
    },
    "index_store": {
      "owner": "third_party",
      "location_label": "customer-vector-index",
      "index_leaves_customer_network": false
    },
    "acl_source": {
      "owner": "third_party",
      "principal_key": "sender_external_id",
      "supports_user_department_group_role": true
    }
  },
  "capability_contracts": {
    "model_routing": {
      "policy_owner": "v3",
      "execution_owner": "third_party",
      "approved_generation_boundary": "local_only"
    },
    "retrieval": {
      "execution_owner": "third_party",
      "evidence_snippets_sent_to_v3": false
    },
    "permissions": {
      "policy_owner": "v3",
      "enforcement_owner": "third_party",
      "deny_unknown_principal": true
    }
  },
  "page_generation": {
    "request_entrypoint": "third_party_gateway",
    "output_modes": [
      "page_blueprint",
      "html_package"
    ],
    "preview_hosted_by": "third_party",
    "publish_hosted_by": "third_party",
    "v3_receives_html_body": false,
    "artifact_status_callback": {
      "mode": "redacted_manifest",
      "fields": [
        "artifact_external_id",
        "content_sha256",
        "source_count",
        "published_url_present",
        "created_at"
      ]
    }
  },
  "observability": {
    "v3_receives_raw_logs": false,
    "v3_receives_redacted_status": true,
    "local_audit_retention_owner": "third_party"
  },
  "security": {
    "credential_delivery": "out_of_band",
    "browser_token_policy": "no_v3_tokens_in_browser",
    "network_policy": "third_party_gateway_to_v3_only",
    "secret_material_included": false
  }
}
